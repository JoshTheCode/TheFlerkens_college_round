# Model Provider Configuration (OpenAI-compatible or OpenRouter)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here
AGENTBREAK_MODEL=openai/gpt-4o-mini

# AgentBreak Coordinator Bounds & Budgets
AGENTBREAK_MAX_ATTEMPTS=3
AGENTBREAK_MODEL_TIMEOUT_SECONDS=15.0
AGENTBREAK_RUN_TIMEOUT_SECONDS=60.0
AGENTBREAK_MAX_TOKENS_BUDGET=20000

# Storage Directory for Traces
AGENTBREAK_DATA_DIR=data/traces
