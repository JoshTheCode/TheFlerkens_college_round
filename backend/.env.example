PROJECT_NAME=AgentBreak-Backend
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite default for rapid local development, Postgres for staging/prod)
DATABASE_URL=sqlite+aiosqlite:///./agentbreak.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentbreak

# Redis (for task queue and pub/sub traces)
REDIS_URL=redis://localhost:6379/0

# Sandbox Security Configurations
SANDBOX_EXECUTION_TIMEOUT=30
ALLOW_LOCAL_SUBPROCESS_SANDBOX=true
