{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentBreak API",
    "description": "Autonomous AI Red Team testing platform for vulnerable AI agents",
    "version": "1.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Gethealth"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/targets": {
      "get": {
        "summary": "List Targets",
        "operationId": "listTargets",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TargetProfile"
                  },
                  "type": "array",
                  "title": "Response Listtargets"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/targets/default": {
      "get": {
        "summary": "Get Default Target",
        "operationId": "getDefaultTarget",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Getdefaulttarget"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/targets/{target_id}": {
      "get": {
        "summary": "Get Target",
        "operationId": "getTarget",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attacks/start": {
      "post": {
        "summary": "Start Attack Run",
        "operationId": "startAttackRun",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/AttackRunRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Req"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionTrace"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attacks/logs": {
      "get": {
        "summary": "Get Attack Logs",
        "operationId": "getAttackLogs",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Getattacklogs"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attacks/{run_id}": {
      "get": {
        "summary": "Get Attack Status",
        "operationId": "getAttackRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Getattackrun"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/attacks/{run_id}/trace": {
      "get": {
        "summary": "Get Attack Trace",
        "operationId": "getAttackTrace",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionTrace"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/defenses/validate": {
      "post": {
        "summary": "Validate Defense",
        "operationId": "validateDefense",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefenseValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttackAttempt": {
        "properties": {
          "attempt_id": {
            "type": "integer",
            "title": "Attempt Id"
          },
          "family": {
            "$ref": "#/components/schemas/AttackFamily"
          },
          "payload": {
            "type": "string",
            "title": "Payload"
          },
          "target_response": {
            "type": "string",
            "title": "Target Response"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCallRecord"
            },
            "type": "array",
            "title": "Tool Calls"
          },
          "memory_before": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Memory Before"
          },
          "memory_after": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Memory After"
          },
          "memory_diff": {
            "$ref": "#/components/schemas/MemoryDiff"
          },
          "adaptation_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Notes"
          },
          "failed_success_predicate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed Success Predicate"
          },
          "model_call": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelCallMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms",
            "default": 0.0
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "attempt_id",
          "family",
          "payload",
          "target_response"
        ],
        "title": "AttackAttempt"
      },
      "AttackFamily": {
        "type": "string",
        "enum": [
          "indirect_prompt_injection",
          "unauthorized_tool_use",
          "memory_poisoning"
        ],
        "title": "AttackFamily"
      },
      "AttackPlan": {
        "properties": {
          "family": {
            "$ref": "#/components/schemas/AttackFamily"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps"
          },
          "success_condition": {
            "type": "string",
            "title": "Success Condition"
          },
          "expected_severity": {
            "$ref": "#/components/schemas/Severity"
          }
        },
        "type": "object",
        "required": [
          "family",
          "objective",
          "steps",
          "success_condition",
          "expected_severity"
        ],
        "title": "AttackPlan"
      },
      "AttackRunRequest": {
        "properties": {
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id",
            "default": "bank_agent_v1"
          },
          "attack_families": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AttackFamily"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attack Families"
          },
          "execution_mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExecutionMode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "AttackRunRequest"
      },
      "DefenseProfile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "Standard Hardened Defense"
          },
          "isolate_untrusted_documents": {
            "type": "boolean",
            "title": "Isolate Untrusted Documents",
            "default": true
          },
          "strict_tool_authorization": {
            "type": "boolean",
            "title": "Strict Tool Authorization",
            "default": true
          },
          "allowed_transfer_recipients": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Transfer Recipients"
          },
          "transfer_amount_limit": {
            "type": "number",
            "title": "Transfer Amount Limit",
            "default": 1000.0
          },
          "validate_memory_writes": {
            "type": "boolean",
            "title": "Validate Memory Writes",
            "default": true
          }
        },
        "type": "object",
        "title": "DefenseProfile"
      },
      "DefenseValidationRequest": {
        "properties": {
          "baseline_run_id": {
            "type": "string",
            "title": "Baseline Run Id"
          },
          "defense_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DefenseProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "baseline_run_id"
        ],
        "title": "DefenseValidationRequest"
      },
      "EvaluationReport": {
        "properties": {
          "baseline_run_id": {
            "type": "string",
            "title": "Baseline Run Id"
          },
          "baseline_findings_count": {
            "type": "integer",
            "title": "Baseline Findings Count"
          },
          "baseline_success_rate": {
            "type": "number",
            "title": "Baseline Success Rate"
          },
          "exact_replay_findings_count": {
            "type": "integer",
            "title": "Exact Replay Findings Count"
          },
          "exact_replay_blocking_rate": {
            "type": "number",
            "title": "Exact Replay Blocking Rate"
          },
          "adaptive_bypass_findings_count": {
            "type": "integer",
            "title": "Adaptive Bypass Findings Count"
          },
          "adaptive_bypass_rate": {
            "type": "number",
            "title": "Adaptive Bypass Rate"
          },
          "legitimate_task_passed": {
            "type": "boolean",
            "title": "Legitimate Task Passed"
          },
          "family_results": {
            "items": {
              "$ref": "#/components/schemas/FamilyReplayResult"
            },
            "type": "array",
            "title": "Family Results"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "cost_status": {
            "type": "string",
            "title": "Cost Status",
            "default": "unavailable"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "baseline_run_id",
          "baseline_findings_count",
          "baseline_success_rate",
          "exact_replay_findings_count",
          "exact_replay_blocking_rate",
          "adaptive_bypass_findings_count",
          "adaptive_bypass_rate",
          "legitimate_task_passed",
          "status"
        ],
        "title": "EvaluationReport"
      },
      "ExecutionMode": {
        "type": "string",
        "enum": [
          "live",
          "deterministic_fixture",
          "prerecorded"
        ],
        "title": "ExecutionMode"
      },
      "ExecutionTrace": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "execution_mode": {
            "$ref": "#/components/schemas/ExecutionMode",
            "default": "deterministic_fixture"
          },
          "target_profile": {
            "$ref": "#/components/schemas/TargetProfile"
          },
          "defense_profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DefenseProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "plans": {
            "items": {
              "$ref": "#/components/schemas/AttackPlan"
            },
            "type": "array",
            "title": "Plans"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttackAttempt"
            },
            "type": "array",
            "title": "Attempts"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "total_findings_count": {
            "type": "integer",
            "title": "Total Findings Count",
            "default": 0
          },
          "total_tokens_used": {
            "type": "integer",
            "title": "Total Tokens Used",
            "default": 0
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cost Usd"
          },
          "cost_status": {
            "type": "string",
            "title": "Cost Status",
            "default": "unavailable"
          },
          "stopping_reason": {
            "$ref": "#/components/schemas/StoppingReason",
            "default": "all_attack_families_completed"
          },
          "start_time": {
            "type": "string",
            "title": "Start Time"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "is_prerecorded": {
            "type": "boolean",
            "title": "Is Prerecorded",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status",
          "target_profile",
          "start_time"
        ],
        "title": "ExecutionTrace"
      },
      "FamilyReplayResult": {
        "properties": {
          "family": {
            "$ref": "#/components/schemas/AttackFamily"
          },
          "baseline_payload": {
            "type": "string",
            "title": "Baseline Payload"
          },
          "replayed_successfully": {
            "type": "boolean",
            "title": "Replayed Successfully"
          },
          "adaptive_bypass_attempted": {
            "type": "boolean",
            "title": "Adaptive Bypass Attempted",
            "default": false
          },
          "adaptive_bypass_succeeded": {
            "type": "boolean",
            "title": "Adaptive Bypass Succeeded",
            "default": false
          },
          "adaptation_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adaptation Notes"
          }
        },
        "type": "object",
        "required": [
          "family",
          "baseline_payload",
          "replayed_successfully"
        ],
        "title": "FamilyReplayResult"
      },
      "Finding": {
        "properties": {
          "family": {
            "$ref": "#/components/schemas/AttackFamily"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "reproduction_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reproduction Steps"
          },
          "mitigation": {
            "type": "string",
            "title": "Mitigation"
          },
          "attempt_id": {
            "type": "integer",
            "title": "Attempt Id"
          },
          "policy_rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Rule Id"
          }
        },
        "type": "object",
        "required": [
          "family",
          "success",
          "severity",
          "objective",
          "evidence",
          "reproduction_steps",
          "mitigation",
          "attempt_id"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryDiff": {
        "properties": {
          "before": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Before"
          },
          "after": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "After"
          },
          "added": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Added"
          },
          "modified": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Modified"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Removed"
          }
        },
        "type": "object",
        "title": "MemoryDiff"
      },
      "ModelCallMetadata": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version",
            "default": "v1"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms",
            "default": 0.0
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "estimated_cost_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost Usd"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model"
        ],
        "title": "ModelCallMetadata"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Severity"
      },
      "StoppingReason": {
        "type": "string",
        "enum": [
          "all_attack_families_completed",
          "attempt_budget_exhausted",
          "time_budget_exhausted",
          "token_budget_exhausted",
          "cost_budget_exhausted",
          "provider_error",
          "cancelled",
          "internal_error"
        ],
        "title": "StoppingReason"
      },
      "TargetProfile": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolDefinition"
            },
            "type": "array",
            "title": "Tools"
          },
          "allowed_resources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Resources"
          },
          "forbidden_resources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Forbidden Resources"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "system_prompt",
          "tools"
        ],
        "title": "TargetProfile"
      },
      "ToolCallRecord": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          },
          "authorized": {
            "type": "boolean",
            "title": "Authorized"
          },
          "policy_rule_id": {
            "type": "string",
            "title": "Policy Rule Id",
            "default": "POL-DEFAULT-ALLOW"
          },
          "requested_resource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Resource"
          },
          "result_summary": {
            "type": "string",
            "title": "Result Summary"
